#  docker run --name cattiva-postgres -e POSTGRES_PASSWORD=mysecretpassword -p 5432:5432 -d postgres
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/cattiva?schema=public"

# Where the CLI dials the server.
CATTIVA_API_URL="http://localhost:3000"

# Model providers. You need a key for whichever provider the model you pick belongs to.
# Gemini has a free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
