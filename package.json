{
  "name": "cattiva",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "iharsh02 <ht266005@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iharsh02/cattiva.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "dev:memory-engine": "bun run packages/memory-engine/src/index.ts",
    "eval:memory-engine": "bun run --filter @cattiva/memory-engine eval",
    "eval:memory-engine:save": "bun run --filter @cattiva/memory-engine eval:save",
    "release:memory-engine": "bun run --filter @cattiva/memory-engine pack:dry",
    "eval:memory-engine:compare": "bun run --filter @cattiva/memory-engine eval:compare"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
